// ==============================================================================
// Kubernetes & Data Science Foundation - Devcontainer
// ==============================================================================
{
  "name": "datasci-k8s-foundation",
  "build": { "dockerfile": "Dockerfile" },

  // ----------------------------------------------------------------------------
  // Workspace & User Mapping
  // ----------------------------------------------------------------------------
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,

  // ----------------------------------------------------------------------------
  // Execution Context & Security Boundaries
  // ----------------------------------------------------------------------------
  "runArgs": [
    // Use host network namespace to access Kubernetes and host-local services
    "--network=host"
  ],

  // ----------------------------------------------------------------------------
  // Credential & Config Injection
  // ----------------------------------------------------------------------------
  // Read-only injection of host Kubernetes and Helm contexts.
  "mounts": [
    "source=${localEnv:HOME}/.config/helm,target=/home/vscode/.config/helm,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.kube/config,target=/home/vscode/.kube/config,type=bind,consistency=cached,readonly"
  ],

  // ----------------------------------------------------------------------------
  // Port Forwarding
  // ----------------------------------------------------------------------------
  // Disable port auto-forwarding for local Jupyter processes
  "portsAttributes": {
    ".*(jupyter|ipykernel_launcher).*": {
      "label": "Jupyter (host network)",
      "onAutoForward": "ignore"
    }
  },

  // ----------------------------------------------------------------------------
  // IDE Execution Tooling
  // ----------------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "redhat.vscode-yaml",
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "opentofu.vscode-opentofu",
        "ckolkman.vscode-postgres"
      ]
    }
  }
}