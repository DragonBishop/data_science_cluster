// Cluster management devcontainer.
{
  "name": "datasci-k8s-host",
  "build": { "dockerfile": "Dockerfile" },

  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/home/vscode/data_science_cluster",
  "workspaceMount": "source=datasci-k8s-host-workspace,target=/home/vscode/data_science_cluster,type=volume",

  // Clones origin into the empty volume once; the .venv (with ipykernel) rebuilds per container.
  "postCreateCommand": "test -d .git || git clone --branch \"$REPO_REF\" \"https://github.com/$REPOSITORY.git\" . && uv sync --frozen --group notebook && uv run ansible-galaxy collection install --upgrade -p ansible ansible/ansible_collections/dragonbishop/cluster",

  "containerEnv": {
    "ANSIBLE_CONFIG": "${containerWorkspaceFolder}/ansible.cfg",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
  },

  // Reaches k3s and the host's loopback services.
  "runArgs": [
    "--network=host"
  ],

  // The cluster's admin credential, the one host file it reads.
  "mounts": [
    "source=${localEnv:HOME}/.kube/config,target=/home/vscode/.kube/config,type=bind,consistency=cached,readonly"
  ],

  // No auto-forward prompts for Jupyter processes.
  "portsAttributes": {
    ".*(jupyter|ipykernel_launcher).*": {
      "label": "Jupyter (host network)",
      "onAutoForward": "ignore"
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        // ansible and ansible-lint from the .venv, with the repo's ansible.cfg.
        "ansible.python.interpreterPath": "/home/vscode/.venv/bin/python",
        "ansible.config.path": "${workspaceFolder}/ansible.cfg",
        // Ansible files auto-detection misses; other .yml stays YAML.
        "files.associations": {
          "**/roles/*/{tasks,handlers,defaults,vars,meta}/**/*.yml": "ansible",
          "**/molecule/*/{tasks,vars}/**/*.yml": "ansible",
          "**/group_vars/**/*.yml": "ansible"
        }
      },
      "extensions": [
        // Python
        "charliermarsh.ruff",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",

        // DataOps
        "ms-azuretools.vscode-containers",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "opentofu.vscode-opentofu",
        "redhat.ansible",

        // Git
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",

        // Syntax
        "redhat.vscode-yaml",
        "samuelcolvin.jinjahtml",
        "tamasfe.even-better-toml",

        // Markdown
        "bierner.github-markdown-preview",
        "bierner.markdown-checkbox",
        "bierner.markdown-emoji",
        "bierner.markdown-footnotes",
        "bierner.markdown-preview-github-styles",
        "rvben.rumdl",

        // Productivity
        "christian-kohler.path-intellisense",
        "usernamehw.errorlens"
      ]
    }
  }
}
