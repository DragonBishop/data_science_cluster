// Host devcontainer for this repo.
{
  "name": "datasci-k8s-host",
  "build": { "dockerfile": "Dockerfile" },

  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/home/vscode/data_science_cluster",
  "workspaceMount": "source=datasci-k8s-host-workspace,target=/home/vscode/data_science_cluster,type=volume",

  "containerEnv": {
    "ANSIBLE_CONFIG": "${containerWorkspaceFolder}/ansible/ansible.cfg"
  },

  // Reaches the local k3s cluster and host-local services directly.
  "runArgs": [
    "--network=host"
  ],

  // Read-only injection of host Kubernetes and Helm contexts.
  "mounts": [
    "source=${localEnv:HOME}/.config/helm,target=/home/vscode/.config/helm,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.kube/config,target=/home/vscode/.kube/config,type=bind,consistency=cached,readonly"
  ],

  // Suppresses the auto-forward notification for local Jupyter processes.
  "portsAttributes": {
    ".*(jupyter|ipykernel_launcher).*": {
      "label": "Jupyter (host network)",
      "onAutoForward": "ignore"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",

        // DataOps
        "dbtlabsinc.dbt",
        "mechatroner.rainbow-csv",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "opentofu.vscode-opentofu",
        "redhat.ansible",

        // Git
        "adam-bender.commit-message-editor",
        "donjayamanne.githistory",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "howardzuo.vscode-git-tags",
        "mhutchie.git-graph",

        // Syntax
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",

        // Productivity
        "aaron-bond.better-comments",
        "christian-kohler.path-intellisense",
        "davidanson.vscode-markdownlint",
        "mushan.vscode-paste-image",
        "usernamehw.errorlens"
      ]
    }
  }
}
