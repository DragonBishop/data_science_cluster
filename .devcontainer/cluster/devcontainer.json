// Devcontainer spec for the in-cluster ETL/pipeline runtime image.
{
  "name": "datasci-k8s-cluster",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "workspaceFolder": "/home/vscode/data_science_cluster",
  "workspaceMount": "source=datasci-k8s-cluster-workspace,target=/home/vscode/data_science_cluster,type=volume",

  "containerEnv": {
    "ANSIBLE_CONFIG": "${containerWorkspaceFolder}/ansible/ansible.cfg"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",

        // DataOps
        "dbtlabsinc.dbt",
        "mechatroner.rainbow-csv",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "opentofu.vscode-opentofu",
        "redhat.ansible",

        // Git
        "adam-bender.commit-message-editor",
        "donjayamanne.githistory",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "howardzuo.vscode-git-tags",
        "mhutchie.git-graph",

        // Syntax
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",

        // Productivity
        "aaron-bond.better-comments",
        "christian-kohler.path-intellisense",
        "davidanson.vscode-markdownlint",
        "mushan.vscode-paste-image",
        "usernamehw.errorlens"
      ]
    }
  }
}
