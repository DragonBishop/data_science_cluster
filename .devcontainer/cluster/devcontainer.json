// In-cluster runtime devcontainer.
{
  "name": "datasci-k8s-cluster",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "workspaceFolder": "/home/vscode/data_science_cluster",
  "workspaceMount": "source=datasci-k8s-cluster-workspace,target=/home/vscode/data_science_cluster,type=volume",

  "containerEnv": {
    "ANSIBLE_CONFIG": "${containerWorkspaceFolder}/ansible.cfg"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python"
      },
      "extensions": [
        // Python
        "charliermarsh.ruff",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",

        // DataOps
        "ms-azuretools.vscode-containers",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "opentofu.vscode-opentofu",
        "redhat.ansible",

        // Git
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",

        // Syntax
        "redhat.vscode-yaml",
        "samuelcolvin.jinjahtml",
        "tamasfe.even-better-toml",

        // Markdown
        "bierner.github-markdown-preview",
        "bierner.markdown-checkbox",
        "bierner.markdown-emoji",
        "bierner.markdown-footnotes",
        "bierner.markdown-preview-github-styles",
        "rvben.rumdl",

        // Productivity
        "christian-kohler.path-intellisense",
        "usernamehw.errorlens"
      ]
    }
  }
}
