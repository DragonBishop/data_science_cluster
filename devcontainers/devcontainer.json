// ==============================================================================
// Kubernetes & Data Science Foundation - Devcontainer
// ==============================================================================
//   This configuration provides a standardized, engine-agnostic environment 
//   for managing Kubernetes clusters and executing data science workloads.
//
//   Users: Customize the "settings" and "extensions" blocks below to add 
//   your preferred themes, formatters, and AI assistants.
// ==============================================================================
{
  "name": "datasci-k8s-foundation",
  "build": { "dockerfile": "Dockerfile" },

  // ----------------------------------------------------------------------------
  // Workspace & User Mapping
  // ----------------------------------------------------------------------------
  // Utilizes a managed volume for maximum cross-platform compatibility and 
  // disk I/O performance. 
  "workspaceMount": "source=datasci-workspace-vol,target=/workspaces/coding,type=volume",
  "workspaceFolder": "/workspaces/coding",
  
  // The official devcontainer base image pre-configures the 'vscode' user
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,

  // ----------------------------------------------------------------------------
  // Execution Context & Security Boundaries
  // ----------------------------------------------------------------------------
  "runArgs": [
    // Bypasses container network isolation so the environment natively 
    // reaches Kubernetes and host-local services (like localhost:5432) 
    // when supported by the container runtime (Linux/WSL2).
    "--network=host"
  ],

  // ----------------------------------------------------------------------------
  // Credential & Config Injection
  // ----------------------------------------------------------------------------
  // Read-only injection of host Kubernetes and Helm contexts.
  "mounts": [
    "source=${localEnv:HOME}/.config/helm,target=/home/vscode/.config/helm,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.kube/config,target=/home/vscode/.kube/config,type=bind,consistency=cached,readonly"
  ],

  // ----------------------------------------------------------------------------
  // IDE Execution Tooling
  // ----------------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "redhat.vscode-yaml",
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "innoverio.vscode-dbt-power-user"
      ]
    }
  }
}