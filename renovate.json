{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests", "group:allNonMajor"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/New_York",
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Python patch releases only; move to a new 3.x by hand once deps support it",
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "description": "k3s and kubectl move together",
      "matchDepNames": ["k3s-io/k3s", "kubernetes/kubernetes"],
      "groupName": "kubernetes"
    },
    {
      "description": "PostGIS operand: track both component versions; keep system-trixie",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgis"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+)-system-trixie$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "cluster-config pins, each annotated with a # renovate: comment",
      "managerFilePatterns": ["/^infrastructure/cluster-config/versions\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+[A-Z0-9_]+: \"(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ]
    },
    {
      "customType": "regex",
      "description": "README versions that mirror a cluster-config pin, each followed by a <!-- renovate: --> comment",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "`(?<currentValue>[^`]+)` <!-- renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))? -->"
      ]
    },
    {
      "customType": "regex",
      "description": "PostGIS image in the documented physical-recovery manifest",
      "managerFilePatterns": ["/^docs/BACKUPS_RESTORE\\.md$/"],
      "matchStrings": [
        "imageName: (?<depName>ghcr\\.io/cloudnative-pg/postgis):(?<currentValue>\\d+\\.\\d+-\\d+\\.\\d+\\.\\d+-system-trixie)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
