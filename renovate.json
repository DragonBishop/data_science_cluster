{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests", "group:allNonMajor"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/New_York",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group annotated cluster pins, including major updates",
      "matchManagers": ["custom.regex"],
      "minimumReleaseAge": "7 days",
      "groupName": "cluster components",
      "separateMajorMinor": false
    },
    {
      "description": "Group workflow actions and tool pins, including major and digest updates",
      "matchManagers": ["github-actions", "custom.regex"],
      "matchFileNames": [".github/workflows/**", ".github/actions/**", "**/action.yml", "**/action.yaml"],
      "minimumReleaseAge": "7 days",
      "groupName": "GitHub Actions",
      "separateMajorMinor": false
    },
    {
      "description": "Update k3s and kubectl together",
      "matchDepNames": ["k3s-io/k3s", "kubernetes/kubernetes"],
      "minimumReleaseAge": "7 days",
      "groupName": "kubernetes"
    },
    {
      "description": "Update Flux controllers, action and CLI together",
      "matchPackageNames": ["fluxcd/flux2", "ghcr.io/fluxcd/flux-cli"],
      "minimumReleaseAge": "7 days",
      "groupName": "Flux",
      "separateMajorMinor": false
    },
    {
      "description": "Allow Python patch updates only",
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor", "major"],
      "minimumReleaseAge": "7 days",
      "enabled": false
    },
    {
      "description": "Track PostgreSQL and PostGIS versions on system-trixie",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgis"],
      "minimumReleaseAge": "7 days",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+)-system-trixie$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Annotated version pins and README versions",
      "managerFilePatterns": [
        ".github/workflows/e2e.yml",
        ".github/workflows/lint.yml",
        "infrastructure/cluster-config/versions.yaml",
        "clusters/local/flux-system/kustomization.yaml",
        "infrastructure/tekton/dashboard/kustomization.yaml",
        "docs/BACKUPS_RESTORE.md",
        "README.md"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\n[^\\n]*?(?<currentValue>v?\\d+\\.\\d+[^\\s\"@/]*)(?:@(?<currentDigest>sha256:[a-f0-9]+))?",
        "`(?<currentValue>[^`]+)` <!-- renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))? -->"
      ]
    }
  ]
}
